# Sao chep thanh .env va tuy chenh (khong chua thong tin bi mat)
# Duong dan file SQLite. De trong -> mac dinh <data_dir>/umd.sqlite3
UMD_DB_PATH=
# Thu muc du lieu (mac dinh: ~/.universal-media-downloader)
UMD_DATA_DIR=
# Thu muc luong video tai ve (mac dinh: <data_dir>/downloads)
UMD_DOWNLOAD_DIR=
# Duong dan ffmpeg neu khong nam tren PATH
UMD_FFMPEG_PATH=
# So tac vu tai song song toi da (mac dinh: 2)
UMD_MAX_CONCURRENT=2
UMD_COOKIE_FILE=  # duong dan file cookies.txt (Netscape format)
